    "def visualize_feature_map(features, base_filename):\n",
    "    os.makedirs(\"feature_maps\", exist_ok=True)\n",
    "\n",
    "    for layer_idx, feat in enumerate(features):\n",
    "        feat = feat[0].detach().cpu()\n",
    "        n_channels = feat.shape[0]\n",
    "\n",
    "        n_cols = 12\n",
    "        n_rows = math.ceil(n_channels / n_cols)\n",
    "\n",
    "        fig, axes = plt.subplots(n_rows, n_cols, figsize=(n_cols*2, n_rows*2))\n",
    "        axes = axes.flatten()\n",
    "\n",
    "        for i in range(n_rows * n_cols):\n",
    "            ax = axes[i]\n",
    "            if i < n_channels:\n",
    "                ax.imshow(feat[i], cmap='gray')\n",
    "                ax.set_title(f'ch{i + 1}', fontsize=8)\n",
    "            ax.axis('off')\n",
    "\n",
    "        plt.tight_layout()\n",
    "        save_path = os.path.join(\"feature_maps\", f\"{base_filename}_layer{layer_idx+1}.png\")\n",
    "        plt.savefig(save_path)\n",
    "        plt.close()\n",
    "        print(f\"✅ Saved feature map: {save_path}\")\n",
    "\n",
    "### END CODE HERE ###"
   ]
